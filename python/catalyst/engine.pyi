"""Type information for Catalyst's synchronous SQLite engine API."""

from collections.abc import Awaitable, Generator, Iterator, Mapping, Sequence
from contextlib import AbstractAsyncContextManager
from pathlib import Path
from typing import Any, final

from ._catalyst import (
    InvalidRequestError,
    NativeConnection,
    NativeMysqlConnection,
    NativePgConnection,
    NativeResult,
)
from .expression import Compiled, Delete, Insert, Select, Update

@final
class TextClause:
    __match_args__: tuple[str, ...]
    text: str
    def __init__(self, text: str) -> None: ...
    def __repr__(self) -> str: ...

@final
class CursorResult:
    def __init__(self, native_result: NativeResult, entity: type[object] | None = ...) -> None: ...
    @property
    def native_result(self) -> NativeResult: ...
    @property
    def keys(self) -> tuple[str, ...]: ...
    @property
    def rowcount(self) -> int: ...
    def fetchone(self) -> tuple[object, ...] | None: ...
    def fetchall(self) -> list[tuple[object, ...]]: ...
    def all(self) -> list[tuple[object, ...]]: ...
    def first(self) -> tuple[object, ...] | None: ...
    def one(self) -> tuple[object, ...]: ...
    def one_or_none(self) -> tuple[object, ...] | None: ...
    def scalar(self) -> object | None: ...
    def scalar_one(self) -> object: ...
    def scalar_one_or_none(self) -> object | None: ...
    def scalars(self) -> ScalarResult: ...
    def __iter__(self) -> Iterator[tuple[object, ...]]: ...

class NoResultFound(InvalidRequestError): ...
class MultipleResultsFound(InvalidRequestError): ...

@final
class ScalarResult:
    def __init__(self, result: CursorResult) -> None: ...
    @property
    def keys(self) -> tuple[str, ...]: ...
    @property
    def rowcount(self) -> int: ...
    def fetchone(self) -> object | None: ...
    def fetchall(self) -> list[object]: ...
    def all(self) -> list[object]: ...
    def first(self) -> object | None: ...
    def one(self) -> object: ...
    def one_or_none(self) -> object | None: ...
    def __iter__(self) -> Iterator[object]: ...

@final
class Connection:
    def __init__(self, native: NativeConnection, *, echo: bool = False) -> None: ...
    def execute(
        self,
        statement: str | TextClause | Compiled | Select | Insert | Update | Delete,
        parameters: Sequence[object] | Mapping[str, object] | None = None,
    ) -> CursorResult: ...
    def begin(self) -> RootTransaction: ...
    def begin_nested(self) -> SavepointTransaction: ...
    def has_table(self, name: str) -> bool: ...
    def commit(self) -> None: ...
    def rollback(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Connection: ...
    def __exit__(self, exc_type: object, exc: object, traceback: object) -> None: ...

@final
class RootTransaction:
    def __init__(self, native: NativeConnection) -> None: ...
    def commit(self) -> None: ...
    def rollback(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> RootTransaction: ...
    def __exit__(self, exc_type: object, exc: object, traceback: object) -> None: ...

@final
class SavepointTransaction:
    def __init__(self, native: NativeConnection, name: str) -> None: ...
    def commit(self) -> None: ...
    def release(self) -> None: ...
    def rollback(self) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> SavepointTransaction: ...
    def __exit__(self, exc_type: object, exc: object, traceback: object) -> None: ...

@final
class AsyncSavepointTransaction:
    def __init__(
        self,
        native: NativeConnection | NativePgConnection | NativeMysqlConnection,
    ) -> None: ...
    async def start(self) -> AsyncSavepointTransaction: ...
    async def commit(self) -> None: ...
    async def release(self) -> None: ...
    async def rollback(self) -> None: ...
    async def close(self) -> None: ...
    def __await__(self) -> Generator[object, None, AsyncSavepointTransaction]: ...
    async def __aenter__(self) -> AsyncSavepointTransaction: ...
    async def __aexit__(self, exc_type: object, exc: object, traceback: object) -> None: ...

@final
class AsyncConnection:
    def __init__(
        self,
        native: NativeConnection | NativePgConnection | NativeMysqlConnection,
        *,
        echo: bool = False,
        postgres: bool = False,
        mysql: bool = False,
    ) -> None: ...
    async def begin(self) -> None: ...
    def begin_nested(self) -> AsyncSavepointTransaction: ...
    async def execute(
        self,
        statement: str | TextClause | Compiled | Select | Insert | Update | Delete,
        parameters: Sequence[object] | Mapping[str, object] | None = None,
    ) -> CursorResult: ...
    async def commit(self) -> None: ...
    async def has_table(self, name: str) -> bool: ...
    async def rollback(self) -> None: ...
    async def close(self) -> None: ...
    async def __aenter__(self) -> AsyncConnection: ...
    async def __aexit__(self, exc_type: object, exc: object, traceback: object) -> None: ...

@final
class _AsyncConnectContext(Awaitable[AsyncConnection]):
    def __init__(self, engine: AsyncEngine) -> None: ...
    def __await__(self) -> Generator[object, None, AsyncConnection]: ...
    async def __aenter__(self) -> AsyncConnection: ...
    async def __aexit__(self, exc_type: object, exc: object, traceback: object) -> None: ...

@final
class AsyncEngine:
    def __init__(
        self,
        database: str | Path,
        *,
        pool_size: int = 5,
        max_overflow: int = 10,
        pool_timeout: float = 30.0,
        timeout: float = 5.0,
        echo: bool = False,
        postgres: bool = False,
        mysql: bool = False,
    ) -> None: ...
    def connect(self) -> _AsyncConnectContext: ...
    async def connect_async(self) -> AsyncConnection: ...
    def begin(self) -> AbstractAsyncContextManager[AsyncConnection]: ...
    async def dispose(self) -> None: ...

@final
class Engine:
    def __init__(
        self,
        database: str | Path,
        *,
        pool_size: int = 5,
        max_overflow: int = 10,
        pool_timeout: float = 30.0,
        timeout: float = 5.0,
        echo: bool = False,
    ) -> None: ...
    def connect(self) -> Connection: ...
    def begin(self) -> Generator[Connection]: ...
    def dispose(self) -> None: ...
    def __enter__(self) -> Engine: ...
    def __exit__(self, exc_type: object, exc: object, traceback: object) -> None: ...

def text(sql: str) -> TextClause: ...
def run_ddl(
    bind: Engine | AsyncEngine,
    tables: Sequence[Any],
    statements: Sequence[Any],
    checkfirst: bool,
    *,
    drop: bool = ...,
) -> Any: ...
async def run_ddl_async(
    bind: AsyncEngine,
    tables: Sequence[Any],
    statements: Sequence[Any],
    checkfirst: bool,
    drop: bool,
) -> None: ...
def create_engine(url: str | Path, **options: Any) -> Engine: ...
def create_async_engine(url: str | Path, **options: Any) -> AsyncEngine: ...
