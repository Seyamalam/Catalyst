"""Type information for Catalyst's Core expression constructors."""

from collections.abc import Iterator, Mapping, Sequence
from typing import TYPE_CHECKING, Any, final

if TYPE_CHECKING:
    from .engine import AsyncEngine, Engine

class TypeEngine: ...
class Integer(TypeEngine): ...

class String(TypeEngine):
    length: int | None
    def __init__(self, length: int | None = ...) -> None: ...

class Boolean(TypeEngine): ...
class Text(TypeEngine): ...
class Float(TypeEngine): ...
class DateTime(TypeEngine): ...
class Date(TypeEngine): ...
class LargeBinary(TypeEngine): ...

@final
class Column:
    __match_args__: tuple[str, ...]
    name: str
    type: object
    primary_key: bool
    nullable: bool | None
    unique: bool
    default: object
    server_default: str | None
    table_name: str
    owner: Table | None
    def __init__(
        self,
        name: str,
        type: object = ...,
        primary_key: bool = ...,
        nullable: bool | None = ...,
        unique: bool = ...,
        default: object = ...,
        server_default: str | None = ...,
    ) -> None: ...
    def serialize(self) -> tuple[object, ...]: ...
    def __eq__(self, other: object) -> Any: ...
    def __ne__(self, other: object) -> Any: ...
    def __lt__(self, other: object) -> Expression: ...
    def __le__(self, other: object) -> Expression: ...
    def __gt__(self, other: object) -> Expression: ...
    def __ge__(self, other: object) -> Expression: ...
    def __add__(self, other: object) -> Expression: ...
    def __sub__(self, other: object) -> Expression: ...
    def __mul__(self, other: object) -> Expression: ...
    def __truediv__(self, other: object) -> Expression: ...
    def __neg__(self) -> Expression: ...
    def in_(self, values: Sequence[object]) -> Expression: ...
    def is_(self, value: object) -> Expression: ...
    def is_not(self, value: object) -> Expression: ...
    def like(self, value: object, escape: str | None = ...) -> Expression: ...
    def between(self, lower: object, upper: object) -> Expression: ...
    def asc(self) -> Expression: ...
    def desc(self) -> Expression: ...

@final
class _ColumnCollection:
    def __init__(self, table: Table) -> None: ...
    def __getattr__(self, name: str) -> Column: ...
    def __getitem__(self, name: str) -> Column: ...
    def __iter__(self) -> Iterator[Column]: ...

@final
class MetaData:
    tables: dict[str, Table]
    def __init__(self) -> None: ...
    def create_all(self, bind: Engine | AsyncEngine, checkfirst: bool = ...) -> Any: ...
    def drop_all(self, bind: Engine | AsyncEngine, checkfirst: bool = ...) -> Any: ...

@final
class Table:
    name: str
    metadata: MetaData
    columns: tuple[Column, ...]
    c: _ColumnCollection
    def __init__(self, name: str, metadata: MetaData, *columns: Column) -> None: ...
    def __iter__(self) -> Iterator[Column]: ...
    def compile_ddl(self) -> Compiled: ...
    def compile_drop(self) -> Compiled: ...
    def create(self, bind: Engine | AsyncEngine, checkfirst: bool = ...) -> Any: ...
    def drop(self, bind: Engine | AsyncEngine, checkfirst: bool = ...) -> Any: ...

@final
class Expression:
    __match_args__: tuple[str, ...]
    node: tuple[object, ...]
    def __init__(self, node: tuple[object, ...]) -> None: ...
    def __and__(self, other: Expression) -> Expression: ...
    def __or__(self, other: Expression) -> Expression: ...
    def __invert__(self) -> Expression: ...
    def __eq__(self, other: object) -> Any: ...
    def __ne__(self, other: object) -> Any: ...
    def __lt__(self, other: object) -> Expression: ...
    def __le__(self, other: object) -> Expression: ...
    def __gt__(self, other: object) -> Expression: ...
    def __ge__(self, other: object) -> Expression: ...
    def __add__(self, other: object) -> Expression: ...
    def __sub__(self, other: object) -> Expression: ...
    def __mul__(self, other: object) -> Expression: ...
    def __truediv__(self, other: object) -> Expression: ...
    def __neg__(self) -> Expression: ...

@final
class Compiled:
    string: str
    params: dict[str, object]
    statement_kind: str
    _ordered: list[object]
    _bind_types: list[str | None]
    _bind_names: list[str]
    _result_types: list[str | None]
    def __init__(
        self,
        sql: str,
        params: dict[str, object],
        kind: str,
        ordered: list[object],
        bind_types: list[str | None],
        bind_names: list[str],
        result_types: list[str | None],
    ) -> None: ...
    def __str__(self) -> str: ...

@final
class Select:
    __match_args__: tuple[str, ...]
    columns: tuple[Column | Expression, ...]
    table: Table | None
    predicate: Column | Expression | None
    ordering: tuple[Column | Expression, ...]
    row_limit: int | None
    row_offset: int | None
    def __init__(
        self,
        columns: tuple[Column | Expression, ...],
        table: Table | None = ...,
        predicate: Column | Expression | None = ...,
        ordering: tuple[Column | Expression, ...] = ...,
        row_limit: int | None = ...,
        row_offset: int | None = ...,
    ) -> None: ...
    def where(self, *clauses: Column | Expression | bool) -> Select: ...
    def order_by(self, *clauses: Column | Expression) -> Select: ...
    def limit(self, value: int) -> Select: ...
    def offset(self, value: int) -> Select: ...
    def compile(self) -> Compiled: ...
    def __str__(self) -> str: ...

@final
class Insert:
    __match_args__: tuple[str, ...]
    table: Table
    values_map: Mapping[str, object]
    def __init__(self, table: Table, values_map: Mapping[str, object] = ...) -> None: ...
    def values(self, values: Mapping[str, object] | None = ..., **kwargs: object) -> Insert: ...
    def compile(self) -> Compiled: ...
    def __str__(self) -> str: ...

@final
class Update:
    __match_args__: tuple[str, ...]
    table: Table
    values_map: Mapping[str, object]
    predicate: Column | Expression | None
    def __init__(
        self,
        table: Table,
        values_map: Mapping[str, object] = ...,
        predicate: Column | Expression | None = ...,
    ) -> None: ...
    def values(self, values: Mapping[str, object] | None = ..., **kwargs: object) -> Update: ...
    def where(self, *clauses: Column | Expression | bool) -> Update: ...
    def compile(self) -> Compiled: ...
    def __str__(self) -> str: ...

@final
class Delete:
    __match_args__: tuple[str, ...]
    table: Table
    predicate: Column | Expression | None
    def __init__(self, table: Table, predicate: Column | Expression | None = ...) -> None: ...
    def where(self, *clauses: Column | Expression | bool) -> Delete: ...
    def compile(self) -> Compiled: ...
    def __str__(self) -> str: ...

def and_(*clauses: Column | Expression) -> Expression: ...
def or_(*clauses: Column | Expression) -> Expression: ...
def not_(clause: Column | Expression) -> Expression: ...
def asc(expression: Column | Expression) -> Expression: ...
def desc(expression: Column | Expression) -> Expression: ...

func: Any

def select(*columns: Column | Expression | Table) -> Select: ...
def insert(table: Table) -> Insert: ...
def update(table: Table) -> Update: ...
def delete(table: Table) -> Delete: ...
